{
    "name": "datafeedwatch/dfwconnector-magento2",
    "description": "DataFeedWatch Connector for Magento 2",
    "require": {
        "php": ">=8.1.0 <9.0.0"
    },
    "type": "magento2-module",
    "version": "3.4.0",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DataFeedWatch\\Connector\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
